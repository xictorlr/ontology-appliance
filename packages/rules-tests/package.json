{
  "name": "@ontology-appliance/rules-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "pnpm run test:emulators",
    "test:emulators": "firebase emulators:exec --config firebase.json --only firestore,storage --project demo-ontology-appliance-rules \"pnpm run test:rules\"",
    "test:rules": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "26.1.2",
    "firebase": "12.16.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
