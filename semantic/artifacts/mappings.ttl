res:mapping-crm-cif a oa:MappingProposal ;
    rdfs:label "CRM cif_no → Customer Identifier"@en ;
    oa:mappingId "mapping-crm-cif" ;
    oa:fieldName "cif_no" ;
    oa:sourceSystem "CRM" ;
    oa:mapsToConcept oa:CustomerIdentifier ;
    oa:proposalStatus "HUMAN_REVIEW" ;
    oa:riskLevel "medium" ;
    oa:sourceSnapshotId "crm-parties@sha256:503d103ab015d2fb7720ba7e4aeed7f54e999426e22bc6e126fd663b79f5146a" ;
    oa:transformation "identity(source_value); scope=CRM; do_not_infer_global_uniqueness" ;
    oa:rationale "Name, uniqueness profile, and join behavior support Customer Identifier; model agreement is intentionally unavailable in mock-verifier mode."@en ;
    oa:counterexample "Two historical merged records reuse CIF-0042, so uniqueness is not absolute."@en ;
    oa:confidenceLexical "0.96"^^xsd:decimal ;
    oa:confidenceStructural "0.92"^^xsd:decimal ;
    oa:confidenceInstance "0.88"^^xsd:decimal ;
    oa:confidenceExternal "0.00"^^xsd:decimal ;
    oa:confidenceModel "0.00"^^xsd:decimal ;
    oa:confidenceEvidenceCoverage "1.00"^^xsd:decimal ;
    oa:confidenceProvenance "1.00"^^xsd:decimal ;
    oa:evidence res:evidence-crm-schema-cif, res:evidence-crm-profile-cif ;
    oa:counterevidence res:evidence-crm-cif-duplicate-0042 ;
    oa:generationTrace res:generation-trace-crm-cif ;
    oa:verificationTrace res:verification-run-crm-cif-mock .

res:mapping-crm-ubo a oa:MappingProposal ;
    rdfs:label "CRM ubo → Ultimate Beneficial Owner"@en ;
    oa:mappingId "mapping-crm-ubo" ;
    oa:fieldName "ubo" ;
    oa:sourceSystem "CRM" ;
    oa:mapsToConcept oa:UltimateBeneficialOwner ;
    oa:derivedRelation res:relation-beneficial-owner ;
    oa:proposalStatus "HUMAN_REVIEW" ;
    oa:riskLevel "high" ;
    oa:sourceSnapshotId "crm-parties@sha256:503d103ab015d2fb7720ba7e4aeed7f54e999426e22bc6e126fd663b79f5146a",
        "kyc-le-2001@sha256:ab6ca88676c4f2091c09228d718cbccb9f6711df9c0727026a5aff820aec1787" ;
    oa:transformation "resolve ubo party reference; assert beneficialOwnerOf only after human review" ;
    oa:rationale "The field links a legal entity to its natural-person beneficial owner and is required by two sanctions traversals."@en ;
    oa:confidenceLexical "0.99"^^xsd:decimal ;
    oa:confidenceStructural "0.95"^^xsd:decimal ;
    oa:confidenceInstance "0.90"^^xsd:decimal ;
    oa:confidenceExternal "0.00"^^xsd:decimal ;
    oa:confidenceModel "0.00"^^xsd:decimal ;
    oa:confidenceEvidenceCoverage "1.00"^^xsd:decimal ;
    oa:confidenceProvenance "1.00"^^xsd:decimal ;
    oa:evidence res:evidence-crm-schema-ubo, res:evidence-kyc-document-1001 ;
    oa:generationTrace res:generation-trace-crm-ubo ;
    oa:verificationTrace res:verification-run-crm-ubo-mock .

res:relation-beneficial-owner a oa:DerivedRelation ;
    rdfs:label "Party beneficialOwnerOf LegalEntity"@en ;
    oa:dependsOn res:mapping-crm-ubo .

res:question-cq-001 a oa:CompetencyQuestion ;
    rdfs:label "CQ-001 sanctioned ownership account traversal"@en ;
    oa:dependsOn res:mapping-crm-ubo .

res:question-cq-002 a oa:CompetencyQuestion ;
   rdfs:label "CQ-002 outbound payments from affected accounts"@en ;
   oa:dependsOn res:mapping-crm-ubo .

