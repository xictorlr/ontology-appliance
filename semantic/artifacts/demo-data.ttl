@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

res:party-p-1001 a oa:Party ;
    skos:prefLabel "Alexei Petrov"@en ;
    oa:sourceSystem "CRM" ;
    oa:sourceRecordId "P-1001" ;
