{
  "name": "@ontology-appliance/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Firebase Functions v2 control-plane triggers for Ontology Appliance.",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf lib coverage",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage=false",
    "test:unit": "vitest run --coverage=false",
    "serve": "pnpm run build && firebase emulators:start --only functions,firestore,storage,tasks",
    "deploy": "firebase deploy --only functions:control-plane"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0",
    "google-auth-library": "10.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
