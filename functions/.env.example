# Firebase parameter used to bind the Storage finalized trigger. Set this to
# the Terraform `input_bucket_name` output in `.env.<firebase-project-id>`.
SOURCE_BUCKET=ontology-appliance-dev-REPLACE_ME-oa-input
FUNCTIONS_SERVICE_ACCOUNT=oa-dev-functions@ontology-appliance-dev-REPLACE_ME.iam.gserviceaccount.com

# Functions materialize the bounded workflow directly in Firestore. This value
# pins the ontology context recorded on deterministic proposals.
ONTOLOGY_BASE_VERSION=2026.07.1-candidate

DEFAULT_TENANT_ID=demo-bank
