# Web / Firebase public configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTO_INIT=false
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
NEXT_PUBLIC_DEMO_MODE=true

# Server-only semantic gateway configuration
SEMANTIC_GATEWAY_URL=http://127.0.0.1:8081
SEMANTIC_GATEWAY_AUDIENCE=
DEMO_TENANT_ID=demo-bank

# Server-only model configuration. Never commit real values.
GENERATOR_PROVIDER=mock
# Provider-neutral verifier selector: mock, openai, or anthropic.
VERIFIER_PROVIDER=mock
# Legacy compatibility only. VERIFIER_PROVIDER takes precedence over this mock default.
OPENAI_VERIFIER_MODE=mock
# Paid providers require a separately reviewed opt-in. Examples only:
# GEMINI_GENERATOR_MODEL=gemini-2.5-flash
# OA_OPENAI_VERIFIER_MODEL=gpt-5.6-terra
# OA_ANTHROPIC_VERIFIER_MODEL=claude-sonnet-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
