{
  "access_mode": "read_only",
  "capabilities": [
    "schema",
    "sample",
    "profile",
    "snapshot"
  ],
  "connector_id": "aml-cases",
  "evidence": {
    "hash_algorithm": "sha256",
    "locator_template": "data/synthetic/aml_cases.csv#row={row}:field={field}"
  },
  "fields": [
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "case_id"
    },
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "party_name"
    },
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "country"
    },
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "matched_party_id"
    },
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "match_features"
    },
    {
      "logical_type": "string",
      "nullable": false,
      "source_path": "risk_level"
    },
    {
      "logical_type": "datetime",
      "nullable": false,
      "source_path": "opened_at"
    }
  ],
  "limits": {
    "maximum_bytes": 65536,
    "maximum_records": 100,
    "timeout_seconds": 30
  },
  "schema_version": "1.0",
  "source": {
    "snapshot_strategy": "content_hash",
    "uri": "data/synthetic/aml_cases.csv"
  },
  "source_type": "csv",
  "tenant_id": "demo-bank"
}
