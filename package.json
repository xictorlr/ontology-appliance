{
  "name": "ontology-appliance",
  "version": "0.1.0",
  "private": true,
  "description": "Governed semantic context for enterprise agents",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.12.3",
  "devDependencies": {
    "firebase-tools": "14.26.0",
    "turbo": "2.10.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.12",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    },
    "patchedDependencies": {
      "firebase-tools@14.26.0": "patches/firebase-tools@14.26.0.patch"
    }
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --filter @ontology-appliance/web dev",
    "dev:web": "pnpm --filter @ontology-appliance/web dev",
    "dev:gateway": "cd services/semantic-gateway && uv run uvicorn ontology_appliance_gateway.main:app --app-dir src --reload --port 8081",
    "format:check": "pnpm --recursive --if-present format:check",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "emulators": "firebase emulators:start --project demo-ontology-appliance",
    "deploy:functions": "pnpm --filter @ontology-appliance/functions build && firebase deploy --only functions",
    "deploy:firebase": "pnpm --filter @ontology-appliance/functions build && firebase deploy --only functions,firestore:rules,firestore:indexes,storage",
    "firebase:iam-v3:check": "node scripts/check_firebase_cli_iam_v3.cjs",
    "infra:fmt": "terraform -chdir=infra fmt -recursive",
    "infra:validate": "terraform -chdir=infra/terraform/environments/dev init -backend=false && terraform -chdir=infra/terraform/environments/dev validate"
  }
}
