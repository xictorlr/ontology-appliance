{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-appliance:contract:connector-manifest:1.0",
  "title": "Ontology Appliance MVP connector manifest",
  "description": "Canonical read-only manifest for the implemented synthetic CSV, JSONL, PDF, and OpenAPI connectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "tenant_id",
    "source_type",
    "access_mode",
    "source",
    "capabilities",
    "fields",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "connector_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_type": { "enum": ["csv", "jsonl", "pdf", "openapi"] },
    "access_mode": { "const": "read_only" },
    "source": { "$ref": "#/$defs/source" },
    "credential_ref": {
      "type": "string",
      "pattern": "^projects/[^/]+/secrets/[^/]+/versions/[^/]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["schema", "sample", "profile", "snapshot"] }
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "evidence": { "$ref": "#/$defs/evidence_policy" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "snapshot_strategy"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "snapshot_strategy": { "enum": ["immutable", "watermark", "content_hash"] },
        "response_fixture": { "type": "string", "minLength": 1 },
        "document_glob": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "logical_type", "nullable"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "logical_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "object",
            "array",
            "binary"
          ]
        },
        "nullable": { "type": "boolean" },
        "source_representation": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_template", "hash_algorithm"],
      "properties": {
        "locator_template": { "type": "string", "minLength": 1 },
        "hash_algorithm": { "const": "sha256" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_bytes": { "type": "integer", "minimum": 1 },
        "maximum_records": { "type": "integer", "minimum": 1 },
        "maximum_pages": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
