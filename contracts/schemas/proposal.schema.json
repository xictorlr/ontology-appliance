{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-appliance:contract:semantic-proposal:1.0",
  "title": "Immutable semantic proposal record",
  "description": "Canonical snake_case contract for discovery proposals. Ranking and verification may route this record but never publish it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "tenant_id",
    "kind",
    "risk",
    "source_snapshot_ids",
    "active_ontology_version",
    "source_locator",
    "target_iri",
    "transformation",
    "evidence",
    "counterevidence",
    "confidence",
    "generator",
    "algorithm_version",
    "deterministic_input",
    "deterministic_input_hash",
    "status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": {
      "enum": ["concept", "relation", "alias", "mapping", "duplicate", "constraint", "assertion", "drift"]
    },
    "risk": { "enum": ["low", "medium", "high"] },
    "source_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "active_ontology_version": { "type": "string", "minLength": 1 },
    "source_locator": { "type": "string", "minLength": 1 },
    "target_iri": { "type": "string", "minLength": 1 },
    "transformation": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "counterevidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "confidence": { "$ref": "#/$defs/confidence" },
    "generator": { "$ref": "#/$defs/generator" },
    "algorithm_version": { "type": "string", "minLength": 1 },
    "deterministic_input": { "type": "object", "additionalProperties": true },
    "deterministic_input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "enum": [
        "PENDING_VERIFICATION",
        "AUTO_APPROVED",
        "HUMAN_REVIEW",
        "REJECTED",
        "QUARANTINED",
        "ABSTAINED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "tenant_id",
        "source_id",
        "snapshot_id",
        "locator",
        "observed_at",
        "extractor_version",
        "content_sha256"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "extractor_version": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "claim": { "type": "string", "maxLength": 2000 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexical", "structural", "instance", "external", "model", "evidence_coverage"],
      "properties": {
        "lexical": { "type": "number", "minimum": 0, "maximum": 1 },
        "structural": { "type": "number", "minimum": 0, "maximum": 1 },
        "instance": { "type": "number", "minimum": 0, "maximum": 1 },
        "external": { "type": "number", "minimum": 0, "maximum": 1 },
        "model": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "model_participated",
        "provider",
        "model",
        "provider_returned_model_id",
        "prompt_version",
        "parameters",
        "token_usage",
        "latency_ms",
        "response_status"
      ],
      "properties": {
        "mode": { "enum": ["deterministic", "live"] },
        "model_participated": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider_returned_model_id": { "type": ["string", "null"] },
        "prompt_version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "token_usage": { "type": ["object", "null"], "additionalProperties": true },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "response_status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
